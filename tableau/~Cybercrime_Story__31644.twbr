        </zone>
        <zone flipboard-zone-id='5' h='19556' hidden='true' id='11' story-point-id='4' type-v2='text' w='34467' x='57733' y='64667'>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff' fontname='Britannic Bold' fontsize='15'>Cases rose by roughly 30% year-over-year, indicating a sharp overall escalation.&quot;</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='22333' hidden='true' id='12' story-point-id='5' type-v2='text' w='38067' x='30400' y='60444'>
          <formatted-text>
            <run fontalignment='0' fontcolor='#ffffff' fontname='Britannic Bold' fontsize='15'>Fraud alone accounts for the vast majority of cases, far outpacing all other motives combined.&quot;</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='18889' hidden='true' id='13' story-point-id='6' type-v2='text' w='42467' x='27933' y='52222'>
          <formatted-text>
            <run fontalignment='0' fontcolor='#ffffff' fontname='Britannic Bold' fontsize='15'>Varanasi and Allahabad saw the sharpest increases, while a few cities bucked the trend with declines.&quot;</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='9333' id='14' story-point-id='8' type-v2='text' w='33333' x='64533' y='51000'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#ffffff' fontname='Britannic Bold' fontsize='15'>Cybercrime is heavily concentrated in a small number of major metros, with Varanasi and Allahabad standing out.&quot;</run>
          </formatted-text>
        </zone>
      </zones>
      <simple-id uuid='{77EB5A0E-9B2D-440D-A4E8-E914639E6F30}' />
