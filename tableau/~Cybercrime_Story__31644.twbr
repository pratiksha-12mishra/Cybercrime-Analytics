        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98222' id='9' param='vert' removable='false' type-v2='layout-flow' w='98934' x='533' y='889'>
            <zone h='98222' id='1' param='vert' removable='false' type-v2='layout-flow' w='98934' x='533' y='889'>
              <zone h='11222' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98934' x='533' y='889' />
              <zone h='87000' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98934' x='533' y='12111'>
                <flipboard active-id='8' nav-type='caption' show-nav-arrows='true'>
                  <story-points>
                    <story-point caption='Where is Cybercrime Concentrated?' captured-sheet='Geographic Concentration' id='8' />
                    <story-point caption='How Did Cybercrime Changed from 2018 to 2019' captured-sheet='Yearly Trend' id='4' />
                    <story-point caption='Which Cybercrime Motives Dominate?' captured-sheet='Motive Breakdown' id='5' />
                    <story-point caption='Which Cities Changed the Most?' captured-sheet='Biggest Movers' id='6' />
